{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/scripts/hooks/guard.py\" --hook-json",
            "timeout": 10,
            "statusMessage": "检查 issue-first 合规"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/scripts/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
